# ========================================================
# SMASH CLUB - ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================
# IMPORTANT: Never commit actual credentials to Git!
# Copy this file to .env and configure your real secrets.

# Backend Server Port (Default: 8080)
PORT=8080

# MongoDB Atlas Connection URI
# Obtain from MongoDB Atlas -> Database -> Connect -> Connect your application
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smashclub?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://smash_admin:YourStrongPassword123@cluster0.mongodb.net/smashclub?retryWrites=true&w=majority

# Spring Security JWT Secret (256-bit Hex Key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Allowed CORS Origins (Comma-separated for frontend web app)
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://smash-club.vercel.app

# Frontend Environment
# Angular production API target URL
NG_APP_API_URL=https://smash-club-backend.onrender.com/api
